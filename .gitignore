reports/*
!reports/*.md

# ---- Testing & coverage ----
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ---- macOS ----
.DS_Store

# ---- IDEs ----
.idea/
.vscode/
*.swp
*.swo
