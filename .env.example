# PolicyLens optional runtime configuration.
# Copy to .env only when overriding a default; do not put secrets here.

# Chunking defaults used by src.chunk
# CHUNK_MIN_TOKENS=300
# CHUNK_MAX_TOKENS=800
# CHUNK_TARGET_TOKENS=500
# CHUNK_OVERLAP_TOKENS=50

# Local Qdrant persistence and the two strategy collections
# QDRANT_STORAGE_DIR=vector_store/qdrant_local
# QDRANT_FIXED_COLLECTION_NAME=policylens_fixed_size_bge_m3
# QDRANT_STRUCTURE_COLLECTION_NAME=policylens_structure_aware_bge_m3

# BGE-M3 model and revision are pinned in src.embed; they are not configurable
# with EMBEDDING_MODEL. Set a cache root only if the model snapshot is elsewhere.
# HF_HOME=/path/to/huggingface
# HF_HUB_CACHE=/path/to/huggingface/hub

# OCR uses the local Tesseract executable. Page-specific language overrides
# are defined by the OCR pipeline; this is its default language.
# TESSERACT_CMD=tesseract
# OCR_LANGUAGE=eng
# OCR_DPI=300
# OCR_TIMEOUT_SECONDS=180
# OCR_PAGE_SEGMENTATION_MODE=3

# Default number of results returned by search
# RETRIEVE_TOP_K=10
